# 網站部署後的公開 URL（用於 OG image 等 metadata）
NEXT_PUBLIC_SITE_URL=https://cycmap-landing.vercel.app

# Demo iframe 來源 URL（必填）
# 填入你的 EcoMap demo 部署 URL，例如 https://ecomap-demo.vercel.app
NEXT_PUBLIC_DEMO_URL=https://ecomap-demo.example.com

# Google Apps Script Webhook URL（必填，從 Google Sheet 取得）
# 請依照 docs/google-apps-script-setup.md 步驟取得此 URL
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXX/exec
